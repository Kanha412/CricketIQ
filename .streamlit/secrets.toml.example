# CricketIQ — Streamlit Secrets Template
# =========================================
# Copy this file to .streamlit/secrets.toml for LOCAL development,
# OR paste each key into the Streamlit Community Cloud secrets UI.
#
# NEVER commit secrets.toml — it is in .gitignore.

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Get this from: https://console.neon.tech → your project → Connection string
# Format: postgresql://user:password@hostname/dbname?sslmode=require
DATABASE_URL = "postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/cricketiq?sslmode=require"

# ── LLM (Gemini) ─────────────────────────────────────────────────────────────
# Get a free key at: https://aistudio.google.com/apikey
LLM_API_KEY = "AIzaSy..."

# ── App Settings ─────────────────────────────────────────────────────────────
ENVIRONMENT = "production"
LOG_LEVEL   = "WARNING"
