# CricketIQ — Environment Variables Template
# ════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to Git — it contains real secrets.
#     .env is already listed in .gitignore.
# ════════════════════════════════════════════════════════════════


# ── Database ─────────────────────────────────────────────────────────────────
# Local development (Docker or local PostgreSQL):
DATABASE_URL=postgresql://cricketiq_user:cricketiq_pass@localhost:5432/cricketiq

# Neon (free cloud PostgreSQL — for deployment):
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/cricketiq?sslmode=require

# Supabase (alternative free tier):
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres


# ── LLM Provider ─────────────────────────────────────────────────────────────
# Which LLM to use for the AI Analyst.
# Options: gemini | groq | ollama
LLM_PROVIDER=gemini

# Model name for the chosen provider:
#   gemini  → gemini-2.0-flash  (recommended — free tier)
#   groq    → llama-3.3-70b-versatile
#   ollama  → llama3.2 (or any locally pulled model)
LLM_MODEL=gemini-2.0-flash

# API key for the LLM provider.
# Gemini: https://aistudio.google.com/apikey  (free, no credit card)
# Groq:   https://console.groq.com/keys       (free tier)
# Ollama: leave blank — it runs locally with no key needed
LLM_API_KEY=your_api_key_here


# ── Embeddings (V2 — RAG) ────────────────────────────────────────────────────
# sentence-transformers model to use for RAG embeddings.
# Runs locally — no API key required. Model downloads on first use (~80MB).
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_PROVIDER=sentence_transformers


# ── Simulation ───────────────────────────────────────────────────────────────
# Number of Monte Carlo trials per What-If simulation.
# Higher = more accurate but slower. 10,000 is a good balance.
N_SIMULATIONS=10000

# Random seed for reproducible simulations.
# Change this to get different (but still reproducible) results.
SIMULATION_RANDOM_SEED=42


# ── Application ───────────────────────────────────────────────────────────────
# Logging verbosity. DEBUG shows everything; INFO is normal operation.
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Runtime environment.
# Options: development | production | testing
ENVIRONMENT=development
